{
  "name": "geo-ar",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-based geographic AR: mountain peaks, settlements and rivers overlaid on the camera view.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --mode https --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:mobile": "vite preview --mode https --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "^6.14.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
